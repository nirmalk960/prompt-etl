# =====================================================================
# Prompt ETL environment configuration
# Copy to .env and adjust for your local stack.
# =====================================================================

# --- App ---
APP_ENV=local
LOG_LEVEL=INFO
# openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-string
# Sent as "Authorization: Bearer <token>". openssl rand -hex 32
ACCESS_TOKEN=change-me-to-a-different-long-random-string
# Leave false. True accepts "Bearer dev:<email>" and is not safe to expose.
ALLOW_DEV_AUTH=false
OPERATOR_EMAIL=you@local

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (Postgres) ---
POSTGRES_USER=prompt_etl
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=prompt_etl
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://prompt_etl:change-me-db-password@postgres:5432/prompt_etl

# --- Redis (queue + pubsub) ---
REDIS_PASSWORD=change-me-redis-password
REDIS_URL=redis://:change-me-redis-password@redis:6379/0

# --- Object storage (S3-compatible; defaults to MinIO in compose) ---
OBJECT_STORE_KIND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=change-me-s3-access-key
S3_SECRET_KEY=change-me-s3-secret-key
S3_BUCKET=prompt-etl

# --- Ollama (NL -> code) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Set to 1 to bypass Ollama and use the deterministic stub codegen for tests/CI.
OLLAMA_DISABLE=0

# --- Engine router defaults ---
# Override the host RAM detection (bytes) — useful for tests.
ENGINE_RAM_OVERRIDE_BYTES=
# Bytes threshold above which the router refuses single-node and (in Phase 2) routes to Spark.
ENGINE_SPARK_THRESHOLD_BYTES=53687091200  # 50 GiB

# --- Worker ---
ARQ_MAX_JOBS=4
ARQ_JOB_TIMEOUT_SECONDS=14400
