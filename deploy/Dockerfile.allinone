# syntax=docker/dockerfile:1.7
# =============================================================================
# PromptETL-Meg — single-image "deploy anywhere" build.
#
# One container runs: nginx (UI + /api proxy), uvicorn API, arq worker,
# Postgres, and Redis, supervised by supervisord. All state lives under the
# /data volume. The engine router adapts to the container's cgroup memory
# limit automatically.
#
# Build (from the PromptETL-Meg repo root):
#   docker build -f deploy/Dockerfile.allinone -t prompt-etl:latest .
#
# Multi-arch build:
#   docker buildx build -f deploy/Dockerfile.allinone \
#     --platform linux/amd64,linux/arm64 -t prompt-etl:latest .
# =============================================================================

# ---------- Stage 1: frontend dist ----------
FROM node:20-alpine AS frontend
WORKDIR /fe
COPY frontend/package.json ./
RUN npm install
COPY frontend/ ./
# No VITE_API_BASE_URL: the app defaults to "/api", served by nginx below.
RUN npm run build

# ---------- Stage 2: final image ----------
FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

# postgresql-15 / redis / nginx / supervisor are all multi-arch Debian packages.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        libgomp1 \
        gcc \
        g++ \
        postgresql-15 \
        redis-server \
        nginx \
        supervisor \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/prompt-etl/backend
COPY backend/pyproject.toml ./
RUN pip install --upgrade pip setuptools wheel && pip install -e .
COPY backend/prompt_etl ./prompt_etl
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./alembic.ini

# Frontend static files.
COPY --from=frontend /fe/dist /opt/prompt-etl/frontend

# Process supervision + web config + entrypoint.
COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY deploy/supervisord.conf /etc/supervisor/supervisord.conf
COPY deploy/entrypoint.sh /opt/prompt-etl/entrypoint.sh
RUN chmod +x /opt/prompt-etl/entrypoint.sh && rm -f /etc/nginx/sites-enabled/default

# ---- In-container service wiring (all loopback; nothing else exposed) ----
ENV APP_ENV=local \
    DATABASE_URL=postgresql+asyncpg://prompt_etl:prompt_etl@127.0.0.1:5432/prompt_etl \
    POSTGRES_USER=prompt_etl \
    POSTGRES_PASSWORD=prompt_etl \
    POSTGRES_DB=prompt_etl \
    REDIS_URL=redis://127.0.0.1:6379/0 \
    OBJECT_STORE_KIND=local \
    LOCAL_STORE_ROOT=/data/objects \
    OLLAMA_BASE_URL=http://host.docker.internal:11434 \
    OLLAMA_MODEL=qwen2.5-coder:7b \
    PGDATA=/data/postgres \
    PGBIN=/usr/lib/postgresql/15/bin

VOLUME /data
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=5 \
    CMD curl -fsS http://127.0.0.1:8080/api/ready || exit 1

ENTRYPOINT ["/opt/prompt-etl/entrypoint.sh"]
